{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "types": ["vite/client"],
    "baseUrl": ".",
    "paths": {
      "@investment/*": ["./src/*"],
      "@image-studio/*": ["../image-studio/src/*"],
      "@ui/*": ["../ui/src/*"],
      "@": ["./src"],
      "@/*": ["./src/*"],
      "@ai-image/contracts": ["../contracts/src/index.ts"],
      "@ai-image/contracts/*": ["../contracts/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
